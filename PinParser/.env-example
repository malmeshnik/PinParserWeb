DEBUG=False
SECRET_KEY=

POSTGRES_DB=pinparser
POSTGRES_USER=pinparser
POSTGRES_PASSWORD=

# Для запуску без Docker. У Docker підключення до db/redis задане в docker-compose.yml
DB_HOST=127.0.0.1
DB_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# Мікросервіс публікації пінів без Docker (за замовчуванням http://localhost:80).
# У Docker використовується http://host.docker.internal:80 — див. docker-compose.yml
# AUTOPOST_API_URL=

# Якщо сайт працює через домен/HTTPS: https://example.com
CSRF_TRUSTED_ORIGINS=

GOOGLE_CREADENTIALS_PATH=/app/credentials.json

NINE_PROXY_API_URL=
